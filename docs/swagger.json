{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "AIRuleX 实时规则引擎（分层架构，全功能）：在线评分（/match、/match/batch、/evaluate、/evaluate/all）、规则热更新（/rules*）、版本管理（/versions*）、运维控制台（/）。",
        "title": "AIRuleX 规则引擎 API",
        "contact": {},
        "version": "2.0"
    },
    "host": "localhost:18080",
    "basePath": "/tcg-rulex-engine",
    "paths": {
        "/": {
            "get": {
                "description": "返回单文件 HTML 规则编辑器（运维控制台）页面。",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "console"
                ],
                "summary": "运维控制台",
                "responses": {
                    "200": {
                        "description": "HTML page",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/evaluate": {
            "post": {
                "description": "对一条规则（rule 文本优先，其次 rule_id，否则内置旗舰规则）评估给定 row，返回是否通过及失败原因。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scoring"
                ],
                "summary": "单规则评估",
                "parameters": [
                    {
                        "description": "评估请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.EvaluateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.EvaluateResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/evaluate/all": {
            "post": {
                "description": "将一条 row 对所有已加载规则评估（门控语义）：仅当满足全部规则时 passed 为 true，否则列出每条未满足的规则及原因。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scoring"
                ],
                "summary": "全规则评估（门控）",
                "parameters": [
                    {
                        "description": "全规则评估请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.EvaluateAllRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.EvaluateAllResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "返回服务健康状态与当前已加载规则数。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "probes"
                ],
                "summary": "健康检查",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.HealthResponse"
                        }
                    }
                }
            }
        },
        "/match": {
            "post": {
                "description": "对单个宽表用户记录进行评分，返回命中的规则 ID 与名称。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scoring"
                ],
                "summary": "在线评分（单用户）",
                "parameters": [
                    {
                        "description": "用户宽表记录（允许附加任意列）",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.UserRow"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.MatchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/match/batch": {
            "post": {
                "description": "对一组宽表用户记录批量评分，返回每个用户的命中结果数组。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scoring"
                ],
                "summary": "在线评分（批量）",
                "parameters": [
                    {
                        "description": "用户宽表记录数组",
                        "name": "users",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/router.UserRow"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/router.MatchResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/metrics": {
            "get": {
                "description": "以 Prometheus 文本曝光格式返回引擎指标：规则数、版本数、在飞用户数、并发上限与最近 /match 延迟分位数。",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "probes"
                ],
                "summary": "Prometheus 指标",
                "responses": {
                    "200": {
                        "description": "Prometheus exposition text",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/ping": {
            "get": {
                "description": "轻量存活探针，返回 {\"ping\":\"pong\"}。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "probes"
                ],
                "summary": "存活探针",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.PingResponse"
                        }
                    }
                }
            }
        },
        "/rules": {
            "get": {
                "description": "返回当前已加载（生效）规则的数量。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "scoring"
                ],
                "summary": "规则数量",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.RuleCountResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "新增或更新一条规则并立即生效（热更新）。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "新增/更新规则",
                "parameters": [
                    {
                        "description": "规则对象",
                        "name": "rule",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.RuleInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.UpsertResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/rules/list": {
            "get": {
                "description": "返回全部可编辑规则。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "规则列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.RuleListResponse"
                        }
                    }
                }
            }
        },
        "/rules/selftest": {
            "post": {
                "description": "验证一条复杂规则的实时新增与删除。请求体可选（{rule,row}），缺省时使用内置旗舰规则与样例用户。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "自检（热增删验证）",
                "parameters": [
                    {
                        "description": "自检请求（可选）",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/router.SelfTestRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.SelfTestResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/rules/test": {
            "post": {
                "description": "对草稿规则文本针对一条样例 row 进行匹配测试，返回是否命中。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "草稿规则测试",
                "parameters": [
                    {
                        "description": "草稿测试请求",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.RuleTestRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.RuleTestResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/rules/{id}": {
            "delete": {
                "description": "按 ID 删除一条规则（实时生效）。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "rules"
                ],
                "summary": "删除规则",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "规则 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.DeleteResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/versions": {
            "get": {
                "description": "返回所有已发布的规则集快照。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "versions"
                ],
                "summary": "版本列表",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.VersionListResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "将当前规则集快照为一个新版本（备注可选）。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "versions"
                ],
                "summary": "发布版本",
                "parameters": [
                    {
                        "description": "发布请求（可选备注）",
                        "name": "request",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/router.PublishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.PublishResponse"
                        }
                    }
                }
            }
        },
        "/versions/{v}/rollback": {
            "post": {
                "description": "将规则集回滚到指定版本快照（实时生效）。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "versions"
                ],
                "summary": "回滚版本",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "版本号",
                        "name": "v",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/router.RollbackResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ast.Reason": {
            "type": "object",
            "properties": {
                "detail": {
                    "description": "human-readable cause, including the actual value",
                    "type": "string"
                },
                "expr": {
                    "description": "the failing predicate / group, in SQL form",
                    "type": "string"
                }
            }
        },
        "engine.Version": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "note": {
                    "type": "string"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Rule"
                    }
                },
                "time": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                }
            }
        },
        "model.Rule": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "priority": {
                    "type": "integer"
                },
                "rule": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                }
            }
        },
        "router.DeleteResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1001
                },
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "router.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "bad rule json: unexpected end of JSON input"
                }
            }
        },
        "router.EvaluateAllRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "$ref": "#/definitions/router.UserRow"
                },
                "uid": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.EvaluateAllResponse": {
            "type": "object",
            "properties": {
                "failed": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/router.FailedRule"
                    }
                },
                "failed_count": {
                    "type": "integer",
                    "example": 58
                },
                "failed_rule_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "passed": {
                    "type": "boolean",
                    "example": false
                },
                "passed_count": {
                    "type": "integer",
                    "example": 2
                },
                "passed_rule_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "total_rules": {
                    "type": "integer",
                    "example": 60
                },
                "uid": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.EvaluateRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "$ref": "#/definitions/router.UserRow"
                },
                "rule": {
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND province IN ('广东','江苏','浙江') AND active_score \u003e= 85"
                },
                "rule_id": {
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "router.EvaluateResponse": {
            "type": "object",
            "properties": {
                "passed": {
                    "type": "boolean",
                    "example": false
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ast.Reason"
                    }
                },
                "rule": {
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND active_score \u003e= 85"
                }
            }
        },
        "router.FailedRule": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "全算子覆盖-精准圈选(旗舰)"
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ast.Reason"
                    }
                },
                "rule": {
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND ... AND marital_status \u003c\u003e '未知'"
                },
                "rule_id": {
                    "type": "integer",
                    "example": 1001
                }
            }
        },
        "router.HealthResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "router.MatchResponse": {
            "type": "object",
            "properties": {
                "hits": {
                    "type": "integer",
                    "example": 2
                },
                "rule_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "rule_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "took_ms": {
                    "type": "number",
                    "example": 0.123
                },
                "uid": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.PingResponse": {
            "type": "object",
            "properties": {
                "ping": {
                    "type": "string",
                    "example": "pong"
                }
            }
        },
        "router.PublishRequest": {
            "type": "object",
            "properties": {
                "note": {
                    "type": "string",
                    "example": "上线 618 大促规则集"
                }
            }
        },
        "router.PublishResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "example": 10
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.RollbackResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 10
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.RuleCountResponse": {
            "type": "object",
            "properties": {
                "rules": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "router.RuleInput": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "example": true
                },
                "id": {
                    "type": "integer",
                    "example": 1001
                },
                "name": {
                    "type": "string",
                    "example": "电商精准营销-广东高价值男性"
                },
                "priority": {
                    "type": "integer",
                    "example": 10
                },
                "rule": {
                    "type": "string",
                    "example": "gender = '男' AND age BETWEEN 25 AND 35 AND province = '广东' AND vip_level \u003e= 3 AND total_amount \u003e= 10000"
                },
                "version": {
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "router.RuleListResponse": {
            "type": "object",
            "properties": {
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Rule"
                    }
                }
            }
        },
        "router.RuleTestRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "$ref": "#/definitions/router.UserRow"
                },
                "rule": {
                    "type": "string",
                    "example": "age \u003e= 30 AND vip_level \u003e= 2 AND total_amount \u003e 5000"
                }
            }
        },
        "router.RuleTestResponse": {
            "type": "object",
            "properties": {
                "matched": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "router.SelfTestRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "$ref": "#/definitions/router.UserRow"
                },
                "rule": {
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND vip_level \u003e= 3 AND active_score \u003e= 85"
                }
            }
        },
        "router.SelfTestResponse": {
            "type": "object",
            "properties": {
                "added_rule_id": {
                    "type": "integer",
                    "example": 990001
                },
                "live_add_ok": {
                    "type": "boolean",
                    "example": true
                },
                "live_remove_ok": {
                    "type": "boolean",
                    "example": true
                },
                "rule": {
                    "type": "string"
                },
                "sample_user": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/router.SelfTestStep"
                    }
                }
            }
        },
        "router.SelfTestStep": {
            "type": "object",
            "properties": {
                "matched": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "rules": {
                    "type": "integer",
                    "example": 11
                },
                "step": {
                    "type": "string",
                    "example": "after_add"
                }
            }
        },
        "router.UpsertResponse": {
