{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "AIRuleX 实时规则引擎 HTTP 接口：在线评分（/match、/match/batch、/evaluate）、规则热更新（/rules*）与版本管理（/versions*）。请求/响应示例取自 data/users.json 与 data/rules.json。",
        "title": "AIRuleX 规则引擎 API",
        "contact": {},
        "version": "2.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/": {
            "get": {
                "description": "返回运维控制台 Web 页面（HTML），用于在线增删改查 / 测试 / 发布规则。",
                "produces": [
                    "text/html"
                ],
                "tags": [
                    "Console"
                ],
                "summary": "规则编辑器控制台",
                "operationId": "editor",
                "responses": {
                    "200": {
                        "description": "HTML 页面",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/evaluate": {
            "post": {
                "description": "将一个宽表用户行在单条规则树上求值，返回是否通过 passed，以及导致未通过的谓词原因列表 reasons（passed=true 时为空）。\n- rule：可选，SQL 规则文本；省略时使用内置 flagship 规则\n- rule_id：可选，对已加载的规则按 ID 取其表达式进行解释（仅当 rule 为空时生效）\n- row：宽表用户字段",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scoring"
                ],
                "summary": "单规则评估并解释",
                "operationId": "evaluate",
                "parameters": [
                    {
                        "description": "评估请求",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.EvaluateRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "评估结果（passed + reasons）",
                        "schema": {
                            "$ref": "#/definitions/router.EvaluateResponse"
                        }
                    },
                    "400": {
                        "description": "JSON 解析或规则解析失败",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "rule_id 未加载",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/healthz": {
            "get": {
                "description": "返回服务存活状态与当前已编译规则数。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "健康检查",
                "operationId": "health_check",
                "responses": {
                    "200": {
                        "description": "服务正常",
                        "schema": {
                            "$ref": "#/definitions/router.HealthResponse"
                        }
                    }
                }
            }
        },
        "/match": {
            "post": {
                "description": "传入一个宽表用户对象（任意列，见 data/users.json 样例），返回命中的规则 ID、规则名与耗时。并发受引擎信号量限制，超出将排队。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scoring"
                ],
                "summary": "单用户实时评分",
                "operationId": "match_single",
                "parameters": [
                    {
                        "description": "宽表用户对象（允许任意附加字段）",
                        "name": "user",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.UserRow"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "命中结果",
                        "schema": {
                            "$ref": "#/definitions/router.MatchResponse"
                        }
                    },
                    "400": {
                        "description": "请求体 JSON 解析失败",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/match/batch": {
            "post": {
                "description": "传入用户对象数组（顶层 JSON 数组），按顺序返回每个用户的命中结果。整批受引擎并发上限约束。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Scoring"
                ],
                "summary": "批量用户实时评分",
                "operationId": "match_batch",
                "parameters": [
                    {
                        "description": "用户对象数组",
                        "name": "users",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/router.UserRow"
                            }
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "逐用户命中结果",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/router.MatchResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "请求体 JSON 解析失败",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/metrics": {
            "get": {
                "description": "以 Prometheus 文本曝光格式输出引擎指标：规则数、版本数、在判用户数、并发上限，以及最近窗口的 /match 延迟分位（p50/p90/p99）。",
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Prometheus 指标",
                "operationId": "metrics",
                "responses": {
                    "200": {
                        "description": "Prometheus 文本格式指标",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/ping2": {
            "get": {
                "description": "轻量存活探针，固定返回 {\"ping\":\"pong2\"}。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "存活探针",
                "operationId": "ping",
                "responses": {
                    "200": {
                        "description": "pong2",
                        "schema": {
                            "$ref": "#/definitions/router.Ping2Response"
                        }
                    }
                }
            }
        },
        "/rules": {
            "get": {
                "description": "返回当前引擎已加载并编译的规则总数。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "规则数量",
                "operationId": "rule_count",
                "responses": {
                    "200": {
                        "description": "规则总数",
                        "schema": {
                            "$ref": "#/definitions/router.RuleCountResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "新增或按 ID 更新一条规则并即时生效（原子重建缓存）。表达式字段名为 \"rule\"（SQL 文本）。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rules"
                ],
                "summary": "新增 / 更新规则（热生效）",
                "operationId": "rule_upsert",
                "parameters": [
                    {
                        "description": "规则对象",
                        "name": "rule",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.RuleInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "写入成功，返回规则总数",
                        "schema": {
                            "$ref": "#/definitions/router.UpsertResponse"
                        }
                    },
                    "400": {
                        "description": "规则 JSON 非法或编译失败",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/rules/list": {
            "get": {
                "description": "返回当前可编辑的全部规则。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rules"
                ],
                "summary": "规则列表",
                "operationId": "rule_list",
                "responses": {
                    "200": {
                        "description": "规则列表",
                        "schema": {
                            "$ref": "#/definitions/router.RuleListResponse"
                        }
                    }
                }
            }
        },
        "/rules/selftest": {
            "post": {
                "description": "对运行中的引擎证明复杂规则的热增 / 热删：评分 → 热加规则（应命中）→ 热删规则（应消失），返回逐步轨迹与两个布尔证明。rule 与 row 均可省略（使用内置 flagship 规则与样例）。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rules"
                ],
                "summary": "规则热增删自检",
                "operationId": "rule_selftest",
                "parameters": [
                    {
                        "description": "可选：自定义规则与样例行",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/router.SelfTestRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "自检结果与轨迹",
                        "schema": {
                            "$ref": "#/definitions/router.SelfTestResponse"
                        }
                    },
                    "400": {
                        "description": "规则解析或热加失败",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/rules/test": {
            "post": {
                "description": "不落库地用一行样例数据测试一条草稿规则是否命中。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rules"
                ],
                "summary": "草稿规则试算",
                "operationId": "rule_test",
                "parameters": [
                    {
                        "description": "草稿规则 + 样例行",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/router.RuleTestRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "是否命中",
                        "schema": {
                            "$ref": "#/definitions/router.RuleTestResponse"
                        }
                    },
                    "400": {
                        "description": "JSON 非法或规则编译失败",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/rules/{id}": {
            "delete": {
                "description": "按 ID 删除规则并即时生效。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rules"
                ],
                "summary": "删除规则（热生效）",
                "operationId": "rule_delete",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 1001,
                        "description": "规则 ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "删除成功，返回规则总数",
                        "schema": {
                            "$ref": "#/definitions/router.DeleteResponse"
                        }
                    },
                    "400": {
                        "description": "ID 非法",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/versions": {
            "get": {
                "description": "返回已发布的规则集版本快照列表。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Versions"
                ],
                "summary": "版本快照列表",
                "operationId": "version_list",
                "responses": {
                    "200": {
                        "description": "版本列表",
                        "schema": {
                            "$ref": "#/definitions/router.VersionListResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "对当前规则集打一个版本快照，可附带备注 note。",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Versions"
                ],
                "summary": "发布版本快照",
                "operationId": "version_publish",
                "parameters": [
                    {
                        "description": "可选备注",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/router.PublishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "新版本号与规则数",
                        "schema": {
                            "$ref": "#/definitions/router.PublishResponse"
                        }
                    }
                }
            }
        },
        "/versions/{v}/rollback": {
            "post": {
                "description": "将规则集回滚到指定版本快照并即时生效。",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Versions"
                ],
                "summary": "回滚到指定版本",
                "operationId": "version_rollback",
                "parameters": [
                    {
                        "type": "integer",
                        "example": 1,
                        "description": "目标版本号",
                        "name": "v",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "回滚成功",
                        "schema": {
                            "$ref": "#/definitions/router.RollbackResponse"
                        }
                    },
                    "400": {
                        "description": "版本号非法",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "版本不存在",
                        "schema": {
                            "$ref": "#/definitions/router.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ast.Reason": {
            "type": "object",
            "properties": {
                "detail": {
                    "description": "human-readable cause, including the actual value",
                    "type": "string"
                },
                "expr": {
                    "description": "the failing predicate / group, in SQL form",
                    "type": "string"
                }
            }
        },
        "engine.Version": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer"
                },
                "note": {
                    "type": "string"
                },
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Rule"
                    }
                },
                "time": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                }
            }
        },
        "model.Rule": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "id": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "priority": {
                    "description": "higher sorts first",
                    "type": "integer"
                },
                "rule": {
                    "type": "string"
                },
                "version": {
                    "description": "monotonic per-rule revision (0 = unset)",
                    "type": "integer"
                }
            }
        },
        "router.DeleteResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1001
                },
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "router.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "bad rule json: unexpected end of JSON input"
                }
            }
        },
        "router.EvaluateRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "description": "The wide-table user row to evaluate.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/router.UserRow"
                        }
                    ]
                },
                "rule": {
                    "description": "SQL rule text. Optional: defaults to the built-in flagship rule when empty.",
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND province IN ('广东','江苏','浙江') AND active_score \u003e= 85"
                },
                "rule_id": {
                    "description": "Optional: explain an already-loaded rule by its ID (used only when \"rule\" is empty).",
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "router.EvaluateResponse": {
            "type": "object",
            "properties": {
                "passed": {
                    "type": "boolean",
                    "example": false
                },
                "reasons": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/ast.Reason"
                    }
                },
                "rule": {
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND active_score \u003e= 85"
                }
            }
        },
        "router.HealthResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "router.MatchResponse": {
            "type": "object",
            "properties": {
                "hits": {
                    "type": "integer",
                    "example": 2
                },
                "rule_ids": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "rule_names": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "took_ms": {
                    "type": "number",
                    "example": 0.123
                },
                "uid": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.Ping2Response": {
            "type": "object",
            "properties": {
                "ping": {
                    "type": "string",
                    "example": "pong2"
                }
            }
        },
        "router.PublishRequest": {
            "type": "object",
            "properties": {
                "note": {
                    "type": "string",
                    "example": "上线 618 大促规则集"
                }
            }
        },
        "router.PublishResponse": {
            "type": "object",
            "properties": {
                "count": {
                    "type": "integer",
                    "example": 10
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.RollbackResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 10
                },
                "version": {
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "router.RuleCountResponse": {
            "type": "object",
            "properties": {
                "rules": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "router.RuleInput": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "example": true
                },
                "id": {
                    "type": "integer",
                    "example": 1001
                },
                "name": {
                    "type": "string",
                    "example": "电商精准营销-广东高价值男性"
                },
                "priority": {
                    "type": "integer",
                    "example": 10
                },
                "rule": {
                    "type": "string",
                    "example": "gender = '男' AND age BETWEEN 25 AND 35 AND province = '广东' AND vip_level \u003e= 3 AND total_amount \u003e= 10000"
                },
                "version": {
                    "type": "integer",
                    "example": 0
                }
            }
        },
        "router.RuleListResponse": {
            "type": "object",
            "properties": {
                "rules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Rule"
                    }
                }
            }
        },
        "router.RuleTestRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "$ref": "#/definitions/router.UserRow"
                },
                "rule": {
                    "type": "string",
                    "example": "age \u003e= 30 AND vip_level \u003e= 2 AND total_amount \u003e 5000"
                }
            }
        },
        "router.RuleTestResponse": {
            "type": "object",
            "properties": {
                "matched": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "router.SelfTestRequest": {
            "type": "object",
            "properties": {
                "row": {
                    "$ref": "#/definitions/router.UserRow"
                },
                "rule": {
                    "type": "string",
                    "example": "age BETWEEN 25 AND 40 AND vip_level \u003e= 3 AND active_score \u003e= 85"
                }
            }
        },
        "router.SelfTestResponse": {
            "type": "object",
            "properties": {
                "added_rule_id": {
                    "type": "integer",
                    "example": 990001
                },
                "live_add_ok": {
                    "type": "boolean",
                    "example": true
                },
                "live_remove_ok": {
                    "type": "boolean",
                    "example": true
                },
                "rule": {
                    "type": "string"
                },
                "sample_user": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/router.SelfTestStep"
                    }
                }
            }
        },
        "router.SelfTestStep": {
            "type": "object",
            "properties": {
                "matched": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "rules": {
                    "type": "integer",
                    "example": 11
                },
                "step": {
                    "type": "string",
                    "example": "after_add"
                }
            }
        },
        "router.UpsertResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1001
                },
                "ok": {
                    "type": "boolean",
                    "example": true
                },
                "rules": {
                    "type": "integer",
                    "example": 11
                }
            }
        },
        "router.UserRow": {
            "type": "object",
            "properties": {
                "active_score": {
                    "type": "number",
                    "example": 91.52
                },
                "age": {
                    "type": "integer",
                    "example": 28
