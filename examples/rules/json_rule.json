[
  {
    "id": 1,
    "name": "成年深广用户 (and + >= + in)",
    "rule": "{\"and\":[{\"field\":\"age\",\"op\":\">=\",\"value\":18},{\"field\":\"city\",\"op\":\"in\",\"values\":[\"深圳\",\"广州\"]}]}",
    "enabled": true
  },
  {
    "id": 2,
    "name": "年龄区间 (between)",
    "rule": "{\"field\":\"age\",\"op\":\"between\",\"values\":[25,40]}",
    "enabled": true
  },
  {
    "id": 3,
    "name": "高分或高等级 (or + >=)",
    "rule": "{\"or\":[{\"field\":\"active_score\",\"op\":\">=\",\"value\":85},{\"field\":\"vip_level\",\"op\":\">=\",\"value\":3}]}",
    "enabled": true
  },
  {
    "id": 4,
    "name": "省份集合 (in)",
    "rule": "{\"field\":\"province\",\"op\":\"in\",\"values\":[\"广东\",\"江苏\",\"浙江\"]}",
    "enabled": true
  },
  {
    "id": 5,
    "name": "排除收入档 (not_in)",
    "rule": "{\"field\":\"income_level\",\"op\":\"not_in\",\"values\":[\"<5k\",\"5k-10k\"]}",
    "enabled": true
  },
  {
    "id": 6,
    "name": "类目前缀 (like)",
    "rule": "{\"field\":\"favorite_category\",\"op\":\"like\",\"value\":\"数%\"}",
    "enabled": true
  },
  {
    "id": 7,
    "name": "排除学生 (not_like)",
    "rule": "{\"field\":\"occupation\",\"op\":\"not_like\",\"value\":\"%学生%\"}",
    "enabled": true
  },
  {
    "id": 8,
    "name": "手机号非空 (isnotnull)",
    "rule": "{\"field\":\"phone\",\"op\":\"isnotnull\"}",
    "enabled": true
  },
  {
    "id": 9,
    "name": "备注为空 (isnull)",
    "rule": "{\"field\":\"remark\",\"op\":\"isnull\"}",
    "enabled": true
  },
  {
    "id": 10,
    "name": "日期区间 (between 字符串边界，脱糖为 >= AND <=)",
    "rule": "{\"field\":\"register_date\",\"op\":\"between\",\"values\":[\"2024-01-01\",\"2024-12-31\"]}",
    "enabled": true
  },
  {
    "id": 11,
    "name": "取反嵌套 (not + and)",
    "rule": "{\"not\":{\"and\":[{\"field\":\"risk_level\",\"op\":\"=\",\"value\":\"高\"},{\"field\":\"vip_level\",\"op\":\"<\",\"value\":1}]}}",
    "enabled": true
  },
  {
    "id": 12,
    "name": "多层组合 (and(>=, or(>=, >=), not_like))",
    "rule": "{\"and\":[{\"field\":\"age\",\"op\":\">=\",\"value\":25},{\"or\":[{\"field\":\"vip_level\",\"op\":\">=\",\"value\":3},{\"field\":\"order_count\",\"op\":\">=\",\"value\":30}]},{\"field\":\"occupation\",\"op\":\"not_like\",\"value\":\"%学生%\"}]}",
    "enabled": true
  },
  {
    "id": 13,
    "name": "复杂-深嵌套 and(or(between,>=), not(or(=, and(=, not_in))))",
    "rule": "{\"and\":[{\"or\":[{\"field\":\"age\",\"op\":\"between\",\"values\":[25,40]},{\"field\":\"vip_level\",\"op\":\">=\",\"value\":5}]},{\"not\":{\"or\":[{\"field\":\"risk_level\",\"op\":\"=\",\"value\":\"高\"},{\"and\":[{\"field\":\"marital_status\",\"op\":\"=\",\"value\":\"未知\"},{\"field\":\"province\",\"op\":\"not_in\",\"values\":[\"广东\",\"江苏\"]}]}]}}]}",
    "enabled": true
  },
  {
    "id": 14,
    "name": "复杂-多条件圈选 and(in, or(>=,>=), like, not_in)",
    "rule": "{\"and\":[{\"field\":\"city\",\"op\":\"in\",\"values\":[\"深圳\",\"广州\",\"杭州\"]},{\"or\":[{\"field\":\"vip_level\",\"op\":\">=\",\"value\":3},{\"field\":\"order_count\",\"op\":\">=\",\"value\":30}]},{\"field\":\"favorite_category\",\"op\":\"like\",\"value\":\"数%\"},{\"field\":\"income_level\",\"op\":\"not_in\",\"values\":[\"<5k\",\"5k-10k\"]}]}",
    "enabled": true
  }
]
