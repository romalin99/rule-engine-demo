# ─────────────────────────────────────────────────────────────────────────
# CEL 示例规则 —— Google cel-go 前端 (engine.CELFrontend)
#
# 库 / Library: github.com/google/cel-go v0.28.1
#   CEL 规范 https://cel.dev   规范/原型仓库 https://github.com/cel-expr/cel-spec
#   前端源码 pkg/parser/cel。
# 解析方式:env.Parse —— 【仅语法解析,不做类型检查】,故 age/city 等变量【无需声明】;
#   字符串单引号 '..' 与双引号 ".." 均合法(CEL 文法 STRING,单双引号皆可)。
#
# 运行 / Run:
#   go mod tidy                       # 首次:解析 cel-go 依赖
#   go run ./cmd/cli -frontend cel -rules examples/rules/cel.cel \
#                    -users examples/rules/users.json
#
# 格式:每行一条 CEL 布尔表达式;'#' 注释;可选 "名称: 表达式"。
# CEL 前端支持:&& || !(...)、比较(== != < <= > >=)、field in [列表]、
#   field.startsWith/endsWith/contains(→ LIKE)。复杂规则由这些【任意嵌套】组合而成。
#   函数/正则/JSON/集合判断请用 native SQL。
# ─────────────────────────────────────────────────────────────────────────

# —— 基础 ——
成年深广: age >= 18 && city in ['深圳', '广州']
高分或高等级: active_score >= 85 || vip_level >= 3
年龄区间: age >= 25 && age <= 40
非高风险: !(risk_level == '高')
省份集合: province in ['广东', '江苏', '浙江']
类目前缀: favorite_category.startsWith('数')
昵称包含: nickname.contains('VIP')
排除省份: !(province in ['西藏', '青海'])

# ═══ 复杂规则(&& || ! 与比较/in/字符串谓词任意嵌套)═══
# —— 两组条件并联 ——
双段人群: (age >= 25 && age <= 40) || (vip_level >= 5 && active_score >= 90)
# —— 圈选 + 或分支 + 排除 ——
高价值圈选: city in ['深圳', '广州'] && (vip_level >= 3 || order_count >= 30) && !(risk_level == '高')
# —— 多字符串谓词 + 集合 ——
画像组合: name.startsWith('v') && nickname.contains('VIP') && province in ['广东', '江苏']
# —— 前后缀择一 + 区间 + 取反包含 ——
类目与年龄: (favorite_category.startsWith('数') || favorite_category.endsWith('码')) && age >= 18 && !(occupation.contains('学生'))
# —— 三层嵌套:或(与, 与(或)) ——
三层嵌套: (city == '深圳' && vip_level >= 4) || (active_score >= 90 && (order_count >= 30 || nickname.contains('VIP')))
